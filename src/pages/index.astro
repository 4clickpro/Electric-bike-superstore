---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const PHONE = '850-299-8575';
const PHONE_TEL = 'tel:8502998575';

// Blog posts for right sidebar — newest first
const allPosts = (await getCollection('blog')).sort((a, b) =>
  new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
const recentPosts = allPosts.slice(0, 5);

// Featured bike — left sidebar (Amazon affiliate)
const FEATURED = {
  title: 'ANIIOKI A8 Pro Max',
  spec: '7000W dual motor • 300-mi range • 46MPH • 72V 70Ah',
  price: '$3,799.00',
  image: '/images/anioki-a8-pro-max.jpg',
  url: 'https://www.amazon.com/ANIIOKI-A8-Pro-Max-Electric/dp/B0GQZ8DMYG?linkCode=ll2&tag=techbot00-20&linkId=7b51cf29eb6dbd8fdefe2f8e01877335&language=en_US&ref_=as_li_ss_tl',
};

// Photo tiles (layout rhythm inspired by coastal rental sites — all branding/photos our own)
const tiles = [
  { href: '#book', image: '/images/destin-sunset.jpg', label: 'Rent a Bike', sub: 'Hourly • Daily • Weekly' },
  { href: `${base}products`, image: '/images/aventon-level3-step-through.jpg', label: 'Bikes for Sale', sub: 'Own your ride' },
  { href: '#book', image: '/images/fat-bike-beach.jpg', label: 'Fat Tire Beach Rides', sub: 'Sand-ready e-bikes' },
  { href: '#book', image: '/images/beach-cruiser.jpg', label: 'Beach Cruisers', sub: 'Cruise the Emerald Coast' },
];
---

<BaseLayout
  title="Electric Bike Rentals & Sales — Destin & Miramar Beach, FL"
  description="Rent or buy electric bikes in Destin and Miramar Beach, FL. Fat tire beach rides, cruisers, and e-bikes for sale. Call 850-299-8575 to book your ride today."
  canonicalURL={new URL(Astro.url.pathname, Astro.site).toString()}
>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="hero-overlay">
      <div class="container hero-inner">
        <p class="hero-eyebrow">Destin &bull; Miramar Beach, Florida</p>
        <h1>Electric Bike <span class="hero-accent">Rentals &amp; Sales</span></h1>
        <p class="hero-sub">Explore the Emerald Coast on two wheels. Fat tire e-bikes, beach cruisers, and step-throughs — delivered ready to ride.</p>
        <a class="phone-big" href={PHONE_TEL}>📞 {PHONE}</a>
        <div class="hero-ctas">
          <a href="#book" class="btn btn-primary">Book a Rental</a>
          <a href={`${base}products`} class="btn btn-outline-light">Shop Bikes</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PHOTO TILE GRID ===== -->
  <section class="section tiles-section">
    <div class="container">
      <h2 class="section-title">Find your ride</h2>
      <p class="section-sub">Book direct with a local shop — no apps, no middleman fees.</p>
      <div class="tile-grid">
        {tiles.map(t => (
          <a href={t.href} class="tile">
            <img src={t.image} alt={t.label} loading="lazy" />
            <div class="tile-label">
              <h3>{t.label}</h3>
              <p>{t.sub}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== MAIN 3-COLUMN: SALES | CENTER | BLOG ===== -->
  <section class="section main-section">
    <div class="container">
      <div class="three-col">

        <!-- LEFT SIDEBAR: FEATURED BIKE (AMAZON) -->
        <aside class="col-sidebar-left">
          <div class="sidebar-card featured-card">
            <h3 class="sidebar-title">⭐ Featured Bike</h3>
            <a href={FEATURED.url} target="_blank" rel="sponsored nofollow noopener" class="feat-item">
              <img src={FEATURED.image} alt={FEATURED.title} loading="lazy" />
              <strong class="feat-title">{FEATURED.title}</strong>
              <span class="feat-spec">{FEATURED.spec}</span>
              <span class="feat-price">{FEATURED.price}</span>
              <span class="feat-cta">Check Price on Amazon →</span>
            </a>
            <p class="feat-disclosure">As an Amazon Associate, we earn from qualifying purchases.</p>
          </div>
          <div class="sidebar-card call-card">
            <h3>Call to Book</h3>
            <a href={PHONE_TEL} class="phone-side">{PHONE}</a>
            <p>Open 7 days a week</p>
          </div>
        </aside>

        <!-- CENTER: WELCOME / RENTAL INFO / WHY US -->
        <main class="col-center">
          <div class="center-card">
            <h2>Welcome to the Emerald Coast's E-Bike Shop</h2>
            <p>
              We're your local electric bike shop serving <strong>Destin</strong> and <strong>Miramar Beach, Florida</strong>.
              Cruise Highway 98, ride the Timpoochee Trail along 30A, or roll straight onto the sand with one of our
              fat tire beach e-bikes. Every rental is fully charged, sanitized, and fitted to you before you ride.
            </p>
            <p>
              Ready to buy? We also sell quality electric bikes — test ride one first, then take it home.
              Locals and visitors welcome.
            </p>
          </div>

          <div class="center-card">
            <h2>How Rentals Work</h2>
            <ol class="steps">
              <li><strong>Call or book</strong> — <a href={PHONE_TEL}>{PHONE}</a> or reserve online</li>
              <li><strong>We fit you</strong> — helmet, lock, and a quick safety walkthrough included</li>
              <li><strong>Ride</strong> — cruise the beach paths, Henderson Beach, and Destin Harbor</li>
              <li><strong>Return or extend</strong> — hourly, daily, weekly, and monthly rates</li>
            </ol>
            <div class="rate-table">
              <div><span>Hourly</span><strong>from $15</strong></div>
              <div><span>Half Day</span><strong>from $39</strong></div>
              <div><span>Full Day</span><strong>from $59</strong></div>
              <div><span>Weekly</span><strong>from $199</strong></div>
            </div>
            <p class="rate-note">Rates vary by model. Call for current availability and delivery options.</p>
          </div>

          <div class="center-card call-band" id="book">
            <h2>Ready to Ride?</h2>
            <p>Serving Destin, Miramar Beach, Sandestin, and 30A. Delivery to your condo or hotel available.</p>
            <a class="phone-big" href={PHONE_TEL}>📞 {PHONE}</a>
          </div>

          <div class="center-card">
            <h2>Why Ride With Us</h2>
            <ul class="why-list">
              <li>✅ Local, owner-operated — real people, not a call center</li>
              <li>✅ Fully charged &amp; sanitized before every rental</li>
              <li>✅ Helmets, locks &amp; baskets included free</li>
              <li>✅ Delivery &amp; pickup to Destin &amp; Miramar Beach condos</li>
              <li>✅ Try before you buy — rental credit toward purchase</li>
            </ul>
          </div>
        </main>

        <!-- RIGHT SIDEBAR: BLOG -->
        <aside class="col-sidebar-right">
          <div class="sidebar-card">
            <h3 class="sidebar-title">📰 From the Blog</h3>
            {recentPosts.map(p => (
              <a href={`${base}blog/${p.id.replace(/\.mdx?$/, '')}/`} class="blog-item">
                {p.data.image && <img src={p.data.image} alt="" loading="lazy" />}
                <div>
                  <strong>{p.data.title}</strong>
                  <time>{new Date(p.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                </div>
              </a>
            ))}
            <a href={`${base}blog`} class="sidebar-more">All articles →</a>
          </div>
          <div class="sidebar-card service-card">
            <h3>Service Area</h3>
            <ul>
              <li>📍 Destin, FL</li>
              <li>📍 Miramar Beach, FL</li>
              <li>📍 Sandestin</li>
              <li>📍 Santa Rosa Beach / 30A</li>
            </ul>
          </div>
        </aside>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===== HERO ===== */
  .hero {
    position: relative;
    min-height: 520px;
    background: url('/images/destin-sunset.jpg') center 35% / cover no-repeat;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6,32,52,.55) 0%, rgba(6,32,52,.75) 100%);
    display: flex;
    align-items: center;
  }
  .hero-inner { text-align: center; padding: 60px 0; }
  .hero-eyebrow {
    text-transform: uppercase;
    letter-spacing: .18em;
    font-size: .85rem;
    font-weight: 700;
    color: #9fd8b8;
    margin-bottom: 10px;
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 14px;
    text-shadow: 0 2px 18px rgba(0,0,0,.4);
  }
  .hero-accent { color: #7be3a6; }
  .hero-sub {
    color: #e8f2ec;
    font-size: 1.1rem;
    max-width: 560px;
    margin: 0 auto 22px;
    line-height: 1.6;
  }
  .phone-big {
    display: inline-block;
    font-size: clamp(1.6rem, 4.5vw, 2.6rem);
    font-weight: 800;
    color: #fff;
    background: rgba(45,138,78,.92);
    padding: 12px 38px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 10px 34px rgba(0,0,0,.35);
    margin-bottom: 22px;
    transition: transform var(--transition-fast), background var(--transition-fast);
  }
  .phone-big:hover { transform: translateY(-2px); background: #2d8a4e; }
  .hero-ctas { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-outline-light {
    border: 2px solid #fff;
    color: #fff;
    background: transparent;
    padding: 12px 30px;
    border-radius: var(--radius-sm);
    font-weight: 700;
    text-decoration: none;
    transition: all var(--transition-fast);
  }
  .btn-outline-light:hover { background: rgba(255,255,255,.15); }

  /* ===== TILES ===== */
  .tiles-section { background: var(--color-bg-elevated); border-bottom: 1px solid var(--color-border); }
  .section-title { text-align: center; font-size: 1.7rem; font-weight: 800; margin-bottom: 6px; }
  .section-sub { text-align: center; color: var(--color-text-muted); margin-bottom: 28px; }
  .tile-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .tile {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    display: block;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .tile:hover { transform: translateY(-4px); box-shadow: 0 14px 34px rgba(0,0,0,.18); }
  .tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tile-label {
    position: absolute;
    inset: auto 0 0 0;
    background: linear-gradient(180deg, transparent, rgba(6,32,52,.88) 60%);
    padding: 34px 16px 14px;
    color: #fff;
  }
  .tile-label h3 { font-size: 1.05rem; font-weight: 800; margin: 0; }
  .tile-label p { font-size: .8rem; margin: 2px 0 0; color: #cfe6d8; }

  /* ===== 3-COLUMN ===== */
  .main-section { padding: 40px 0; }
  .three-col {
    display: grid;
    grid-template-columns: 250px 1fr 280px;
    gap: 28px;
    align-items: start;
  }
  .col-center { display: flex; flex-direction: column; gap: 22px; }
  .center-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 26px 28px;
  }
  .center-card h2 { font-size: 1.3rem; font-weight: 800; margin-bottom: 12px; }
  .center-card p { color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 10px; }
  .center-card p:last-child { margin-bottom: 0; }
  .steps { padding-left: 20px; line-height: 1.9; color: var(--color-text-secondary); }
  .steps a { color: var(--color-accent); font-weight: 700; }

  .rate-table {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 16px 0 8px;
  }
  .rate-table > div {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 12px 10px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .rate-table span { font-size: .78rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: .05em; }
  .rate-table strong { font-size: 1.05rem; color: var(--color-accent); }
  .rate-note { font-size: .78rem; color: var(--color-text-muted); font-style: italic; }

  .call-band { text-align: center; background: linear-gradient(135deg, #103c25, #1d6b40); border: none; }
  .call-band h2 { color: #fff; }
  .call-band p { color: #cfe6d8; }
  .call-band .phone-big { margin: 8px 0 0; }

  .why-list { list-style: none; padding: 0; line-height: 2; color: var(--color-text-secondary); }

  /* ===== SIDEBARS ===== */
  .col-sidebar-left, .col-sidebar-right { display: flex; flex-direction: column; gap: 22px; }
  .sidebar-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 20px;
    position: sticky;
    top: 96px;
  }
  .sidebar-title { font-size: 1rem; font-weight: 800; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 2px solid var(--color-accent); }
  .sale-item {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border-light);
    text-decoration: none;
  }
  .sale-item img { width: 74px; height: 56px; object-fit: cover; border-radius: 6px; border: 1px solid var(--color-border); }
  .sale-item strong { display: block; font-size: .84rem; color: var(--color-text-primary); line-height: 1.3; }
  .sale-price { font-size: .92rem; font-weight: 800; color: var(--color-accent); }
  .blog-item {
    display: flex;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border-light);
    text-decoration: none;
  }
  .blog-item img { width: 74px; height: 56px; object-fit: cover; border-radius: 6px; border: 1px solid var(--color-border); }
  .blog-item strong { display: block; font-size: .82rem; color: var(--color-text-primary); line-height: 1.35; }
  .blog-item time { font-size: .72rem; color: var(--color-text-muted); }
  .sidebar-more {
    display: block;
    padding-top: 12px;
    font-weight: 700;
    font-size: .88rem;
    color: var(--color-accent);
    text-decoration: none;
  }
  .call-card { text-align: center; }
  .call-card h3 { font-size: 1rem; margin-bottom: 8px; }

  /* Featured bike card */
  .feat-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
  }
  .feat-item img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }
  .feat-title { font-size: 1rem; font-weight: 800; color: var(--color-text-primary); line-height: 1.3; }
  .feat-spec { font-size: .8rem; color: var(--color-text-muted); line-height: 1.5; }
  .feat-price { font-size: 1.3rem; font-weight: 800; color: #B12704; }
  .feat-cta {
    display: block;
    background: #FF9900;
    color: #111;
    font-weight: 800;
    font-size: .9rem;
    text-align: center;
    padding: 10px 12px;
    border-radius: 8px;
    transition: filter var(--transition-fast);
  }
  .feat-item:hover .feat-cta { filter: brightness(.95); }
  .feat-disclosure { font-size: .68rem; color: var(--color-text-muted); font-style: italic; margin: 10px 0 0; }

  .phone-side {
    display: block;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-accent);
    text-decoration: none;
    margin-bottom: 4px;
  }
  .call-card p { font-size: .8rem; color: var(--color-text-muted); margin: 0; }
  .service-card ul { list-style: none; padding: 0; line-height: 2.1; font-size: .88rem; color: var(--color-text-secondary); }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1080px) {
    .three-col { grid-template-columns: 230px 1fr; }
    .col-sidebar-right { grid-column: 1 / -1; flex-direction: row; }
    .col-sidebar-right .sidebar-card { flex: 1; position: static; }
    .tile-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .hero { min-height: 460px; }
    .three-col { grid-template-columns: 1fr; }
    .col-sidebar-right { flex-direction: column; }
    .tile-grid { grid-template-columns: 1fr; }
    .rate-table { grid-template-columns: repeat(2, 1fr); }
    .sidebar-card { position: static; }
  }
</style>
